{
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "expo": "~57.0.0",
    "expo-audio": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.0",
    "expo-sharing": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2"
  },
  "description": "A mobile application for customizing Sprunki characters.",
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "~19.2.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleNameMapper": {
      "^expo-file-system$": "<rootDir>/__tests__/mocks/expoFileSystemMock.ts",
      "^expo-audio$": "<rootDir>/__tests__/mocks/expoAudioMock.ts"
    },
    "testPathIgnorePatterns": ["/node_modules/", "/__tests__/mocks/"]
  },
  "main": "index.js",
  "name": "sprunki-character-customizer",
  "private": true,
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "test": "jest",
    "web": "expo start --web"
  },
  "version": "1.0.0"
}
